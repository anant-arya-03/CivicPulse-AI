# ─────────────────────────────────────────────────────────────
# CivicPulse AI — environment variables
# Copy to `.env` in the repository root and fill in real values.
# NEVER commit `.env`. Only the backend reads this file.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────
# Local PostgreSQL:
DATABASE_URL=postgresql+psycopg://civicpulse:civicpulse_dev@localhost:5432/civicpulse
TEST_DATABASE_URL=postgresql+psycopg://civicpulse:civicpulse_dev@localhost:5432/civicpulse_test
# Supabase (session pooler / direct, port 5432):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<host>:5432/postgres?sslmode=require

# ── Auth & security ──────────────────────────────────────────
SESSION_COOKIE_NAME=cp_session
CSRF_COOKIE_NAME=cp_csrf
SESSION_TTL_HOURS=168               # 7 days
COOKIE_SECURE=false                 # true in production (HTTPS)
CORS_ORIGINS=http://localhost:3000  # comma-separated
RATE_LIMIT_ENABLED=true             # login/register: 10 attempts per minute per IP

# ── File storage ─────────────────────────────────────────────
STORAGE_BACKEND=local               # local | s3 (later)
LOCAL_STORAGE_DIR=./storage         # relative to backend/
MAX_UPLOAD_MB=10

# ── AI ───────────────────────────────────────────────────────
# mock = free, offline sample answers labelled "Demo AI" (default). anthropic = real Claude.
AI_PROVIDER=mock
# What the mock answers: pothole | streetlight | garbage | not_civic | failure | invalid
MOCK_AI_SCENARIO=pothole
MOCK_AI_RESOLUTION=resolved        # before/after comparison: resolved | not_resolved | partial | unsure | different_place
AI_MODEL=claude-opus-5-5
# low | medium | high: how much the model thinks before answering
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=90
# Needed only for AI_PROVIDER=anthropic. Server-side only: never put it in frontend code.
ANTHROPIC_API_KEY=

# ── Email ────────────────────────────────────────────────────
EMAIL_PROVIDER=mock                 # mock only: simulated submissions, nobody is contacted
MOCK_EMAIL_SCENARIO=success         # success | failure | flaky (first attempt fails)
EMAIL_FROM_ADDRESS=civicpulse-demo@example.com
ALLOW_REAL_SUBMISSIONS=false        # safety guard for a future real provider; leave false

# ── Geocoding (address search) ───────────────────────────────
# mock = fictional "Demo City" sample places, works offline (default).
# nominatim = real OpenStreetMap addresses. Needs a real contact in NOMINATIM_USER_AGENT
# (Nominatim usage policy); the backend refuses to start with the placeholder below.
GEOCODER=mock
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CivicPulseAI-student-project (contact: you@example.com)

# ── Follow-ups ───────────────────────────────────────────────
FOLLOWUP_FIRST_AFTER_DAYS=7         # if the department lists no response time
FOLLOWUP_INTERVAL_DAYS=7
FOLLOWUP_MAX_COUNT=2                # reminders per complaint, then escalation is suggested
SCHEDULER_MAX_ATTEMPTS=3            # retries for a failing scheduled check

# ── Development / demo ───────────────────────────────────────
ENABLE_SIMULATION=true              # demo tools (simulated replies, skip ahead) and worker --now; must be false in production

# ── Frontend (optional; put in frontend/.env.local if needed) ─
# BACKEND_URL=http://localhost:8000  # server-side only, used by Next.js rewrites
